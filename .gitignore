# Dependency directories (Never commit these!)
node_modules/
jspm_packages/
web_modules/
.pnpm-store/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data and process IDs
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul or nyc
coverage
*.lcov
.nyc_output

# Build and Compilation outputs
build/Release
dist/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/

# TypeScript cache
*.tsbuildinfo

# Optional caches and histories
.npm
.eslintcache
.node_repl_history
*.tgz

# Local environment variables (Crucial for security!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files (Optional but recommended)
.DS_Store
Thumbs.db
